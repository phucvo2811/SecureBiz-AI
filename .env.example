# Copy to .env for local development. Never commit real credentials.
COMPOSE_PROJECT_NAME=securebiz-ai
FRONTEND_PORT=80

# PostgreSQL
POSTGRES_DB=securebiz
POSTGRES_USER=securebiz
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=jdbc:postgresql://postgres:5432/securebiz
DATABASE_USERNAME=securebiz
DATABASE_PASSWORD=change-me

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# S3-compatible object storage
S3_ACCESS_KEY=securebiz-local
S3_SECRET_KEY=change-me-now
S3_ENDPOINT=http://object-storage:9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET_PRODUCTS=product-media
S3_BUCKET_DOCUMENTS=documents
S3_REGION=us-east-1

# Backend
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=local
JWT_ISSUER=securebiz-ai
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=14d
JWT_SIGNING_KEY=replace-with-at-least-32-random-bytes
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCK_DURATION=15m
AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_RATE_WINDOW=1m
AUTH_REFRESH_COOKIE_SECURE=false
OUTBOX_POLL_DELAY_MS=1000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=10
# Optional one-time local bootstrap. Leave password empty after first successful startup.
BOOTSTRAP_OWNER_USERNAME=owner
BOOTSTRAP_OWNER_EMAIL=owner@example.invalid
BOOTSTRAP_OWNER_PASSWORD=
# Local thesis/demo dataset. Never enable this in production.
DEMO_DATA_ENABLED=true
DEMO_ACCOUNT_PASSWORD=SecureBiz@123
ALLOWED_ORIGINS=http://localhost:5173
AI_SERVICE_URL=http://ai-service:8000
INTERNAL_AI_API_KEY=replace-with-random-service-credential
LLM_ENABLED=false
LLM_ENDPOINT=http://host.docker.internal:11434/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=
LLM_PROVIDER=openai-compatible

# AI service
AI_SERVICE_PORT=8000
AI_MODEL_DIR=/app/models/artifacts
AI_RANDOM_SEED=42
AI_DEFAULT_MODEL=isolation_forest
AI_LOG_LEVEL=INFO

# Frontend (only VITE_ variables are exposed to browser code)
VITE_APP_NAME=SecureBiz AI
VITE_API_BASE_URL=/api/v1
